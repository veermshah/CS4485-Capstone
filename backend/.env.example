# Frontend origin for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Optional: external VLM prediction API.
# When set, backend will POST {building_id, context} to this URL.
VLM_ENDPOINT_URL=

# Optional: external chat API.
# When set, backend will POST {message, conversation, building_context, prediction}.
CHAT_ENDPOINT_URL=

# Optional API key forwarded as Authorization: Bearer <key>
MODEL_API_KEY=

# For generating absolute image URLs when needed by external models
PUBLIC_BASE_URL=http://localhost:3000

# Google Gemini API key — powers the /v1/chat endpoint via damage_chatbot.py
GEMINI_API_KEY=
